{
  "connections": {
    "main": {"type": "sqlite", "path": "data/main.db", "allow_raw_sql": false},
    "scratch": {"type": "sqlite", "path": "data/scratch.db", "allow_raw_sql": true, "cache": {"ttl_seconds": 0}}
