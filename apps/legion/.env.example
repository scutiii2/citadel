# Copy to .env. Never commit real values. Everything here is optional; empty means the default.
# Service keys are made on first start. Model keys are not set here:
# gateway addresses and Legion's gateway tokens are set in Legion admin > Connections.

# Addresses outside Docker (Compose sets them in the stack).
# Treasury, default http://127.0.0.1:29602
DB_GATEWAY_URL=
# Armory, default http://127.0.0.1:29600/mcp
MCP_SERVER_URL=

# Used only while Treasury cannot be reached, or when Connections holds no value.
# Defaults: http://127.0.0.1:29407 and http://127.0.0.1:29406
CONVERSATION_GATEWAY_URL=
CONVERSATION_GATEWAY_TOKEN=
DECISION_GATEWAY_URL=
DECISION_GATEWAY_TOKEN=

# Model ids for gateway presets that name them as {NAME} placeholders (gateways/*).
# A preset with an empty placeholder leaves that model out.
# openai.azure: deployment names.
AZURE_OPENAI_DEPLOYMENT_DEFAULT=
AZURE_OPENAI_DEPLOYMENT_LIGHT=
AZURE_OPENAI_DEPLOYMENT_STANDARD=
AZURE_OPENAI_DEPLOYMENT_HEAVY=
# vllm: served model names.
VLLM_MODEL_DEFAULT=
VLLM_MODEL_LIGHT=
VLLM_MODEL_STANDARD=
VLLM_MODEL_HEAVY=
