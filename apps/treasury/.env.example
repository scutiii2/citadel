# Copy to .env (created from this file on first run). Never commit real values.

# Service identity keys are generated automatically. Optional directory overrides:
# CITADEL_TRUST_DIR=~/.citadel/trust
# CITADEL_IDENTITY_DIR=../../.data/treasury/identity

# Connection secrets (Postgres DSNs, Firestore key paths) also go here.
# Use them in a connection saved on the Connections page of Treasury Admin as "${NAME}".
