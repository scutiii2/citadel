# Internal API auth. Use the same value as mcp_server's INTERNAL_API_TOKEN
# (mcp_server/.env) and ember_api's (ember_api/secrets/secret_internal_api.env).
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# When set, this agent's /mcp rejects requests without X-Internal-Token, and
# the agent sends it on its calls to mcp_server and peer agents. Leave blank
# only while every caller stays on this machine.
INTERNAL_API_TOKEN=

# Credentials for ai_agent. Copy to .env and fill in real values (the loaders
# also create .env from this file on first run). .env is gitignored. Every
# agent the supervisor starts reads this same file.

# Provider and gateway are set per agent in agents/<id>.json (llm.provider,
# llm.gateway), not here. llm.gateway picks a block of
# configs/config_gateways.json (default: "claude" for anthropic, "gpt" for
# openai). That file holds only "{ENV_VAR_NAME}" pointers; the real values go
# below. Startup requires a key only for gateways an agent uses.

# anthropic: claude gateway
CLAUDE_API_KEY=

# anthropic.openrouter
OPENROUTER_AUTH_TOKEN=
OPENROUTER_API_KEY=

# anthropic.bedrock
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# anthropic.vertex
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=

# anthropic.litellm (self-hosted proxy, Anthropic-passthrough mode)
LITELLM_BASE_URL=
LITELLM_API_KEY=

# anthropic.portkey
PORTKEY_API_KEY=

# anthropic.helicone reuses CLAUDE_API_KEY

# anthropic.omniroute (self-hosted: npm install -g omniroute, then run
# `omniroute`). Model names need a provider prefix, e.g.
# "anthropic/claude-sonnet-5" (set in config_gateways.json). Upstream
# credentials live in OmniRoute's own config; OMNIROUTE_API_KEY is only this
# gateway's client-auth key.
OMNIROUTE_BASE_URL=http://127.0.0.1:20128
OMNIROUTE_API_KEY=

# openai: gpt gateway (default; the SDK already targets api.openai.com)
GPT_API_KEY=

# openai.azure
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# openai: other gateways are plain base_url swaps (together, groq, fireworks, opencode,
# deepinfra, perplexity, ollama, vllm)
TOGETHER_API_KEY=
GROQ_API_KEY=
OPENCODE_API_KEY=
FIREWORKS_API_KEY=
DEEPINFRA_API_KEY=
PERPLEXITY_API_KEY=

# ollama/vllm are usually self-hosted. The OpenAI SDK needs a non-empty
# api_key even if the server ignores it, so use any placeholder.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_MODEL=

# Optional: the remote classifier (Jev), used only when config_tuning.json classifier turns a
# feature on. Text sent to it leaves this machine. TYPESAFE_API_KEY is TypeSafe's own API
# (console.typesafe.ai/keys); VERCEL_GATEWAY_API_KEY reaches the same model through Vercel
# AI Gateway. The classifier.chains setting says which is tried first.
TYPESAFE_API_KEY=
VERCEL_GATEWAY_API_KEY=

# Optional: Hugging Face token. The Triage Assistant downloads its Laya checkpoints (the English one, and
# typed-decisions) from the Hub; downloads work without a token, a token
# only lifts the rate limit.
HF_TOKEN=

# The shared Laya service (Python/laya_service). Compose sets the URL; set it here only when you run Garrison
# outside Docker (the service listens on 127.0.0.1:9120 by default). LAYA_TOKEN must match the service's.
LAYA_SERVICE_URL=
LAYA_TOKEN=
