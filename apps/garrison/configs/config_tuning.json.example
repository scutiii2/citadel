{
  "gateway_failover": {
    "quota_cooldown_seconds": 3600,
    "auth_cooldown_seconds": 3600,
    "unavailable_cooldown_seconds": 30
  },
  "token_limits": {
    "default": {
      "max_output_tokens": 2048,
      "max_context_tokens": 100000,
      "max_tool_rounds": 15
    },
    "anthropic": {},
    "openai": {
      "gateways": {
        "ollama": {
          "max_context_tokens": 16384
        }
      }
    }
  },
  "classifier": {
    "triage_fallback": false,
    "triage_trace": false,
    "triage_window": 4096,
    "triage_thresholds": {
      "2": { "laya-english": 0.90, "laya-typed": 0.80, "jev": 0.90 },
      "3+": { "laya-english": 0.75, "laya-typed": 0.55, "jev": 0.90 }
    },
    "triage_enabled": {
      "laya-english": { "choice": true, "noul": true, "score": true },
      "laya-typed": { "choice": true, "noul": true, "score": true },
      "jev": { "choice": true, "noul": true, "score": true }
    },
    "triage_order": {
      "choice": ["laya-english", "laya-typed", "jev"],
      "noul": ["laya-typed", "jev"],
      "score": ["laya-english", "laya-typed", "jev"]
    },
    "triage_prune_ratio": 0.25,
    "triage_pair_ratio": 0.5,
    "timeout_seconds": 3.0,
    "max_input_chars": 16000,
    "typesafe": {
      "url": "https://api.typesafe.ai/v1/systemone",
      "model": "jev-latest"
    },
    "vercel": {
      "url": "https://ai-gateway.vercel.sh/v1/chat/completions",
      "model": "typesafe-ai/jev"
    },
    "chains": {
      "triage": ["jev", "jev_vercel"],
      "auto_tier": ["jev", "jev_vercel"],
      "auto_route": ["jev", "jev_vercel"]
    },
    "auto_tier": { "enabled": false, "min_confidence": 60 },
    "auto_route": { "enabled": false, "min_confidence": 60 }
  }
}
