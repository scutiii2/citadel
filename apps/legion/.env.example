# Copy to .env. Never commit real values.

# Service assertions: keys are created on first start. Compose supplies trust/identity mounts.

# Treasury address, outside Docker only (compose sets it).
DB_GATEWAY_URL=

# Model keys are not set here. Gateway addresses and Legion's tokens: Legion admin > Connections.

# openai.azure: deployment names used as model ids.
AZURE_OPENAI_DEPLOYMENT_DEFAULT=
AZURE_OPENAI_DEPLOYMENT_LIGHT=
AZURE_OPENAI_DEPLOYMENT_STANDARD=
AZURE_OPENAI_DEPLOYMENT_HEAVY=
