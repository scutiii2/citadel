# Copy to .env. Never commit real values.

# First admin, created on first start.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# Blank: shared token made on first start (INTERNAL_TOKEN_FILE). A value overrides it for this app.
INTERNAL_API_TOKEN=

# Tool service tokens: Tokens card on each service's admin page. Same values as armory.
BARD_TOKEN=
SCRIBE_TOKEN=

# Email is sent by armory (configs/config_email.json), not from here.
