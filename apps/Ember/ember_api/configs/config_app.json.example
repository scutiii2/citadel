{
  "host": "127.0.0.1",
  "port": 8030,
  "database_path": "data/ember_api.db",
  "session_cookie_name": "ember_session",
  "session_hours": 12,
  "cookie_secure": false,
  "default_role": "Member",
  "require_email_verification": true,
  "agents_registry_path": "../../legion/.data/agent_registry.json",
  "mcp_server_url": "http://127.0.0.1:8010/mcp",
  "bard_url": "http://127.0.0.1:8090",
  "scribe_url": "http://127.0.0.1:8091",
  "db_gateway": {
    "url": "http://127.0.0.1:8071",
    "instance": "ember",
    "connection": "data"
  },
  "security": {
    "trusted_proxies": [
      "127.0.0.1",
      "::1"
    ],
    "rate_limit": {
      "enabled": true,
      "scope": "both",
      "max_attempts": 5,
      "window_seconds": 900,
      "lockout_seconds": 900
    },
    "ip_filter": {
      "allow_list": [],
      "deny_list": []
    },
    "headers": {
      "enabled": true,
      "hsts_max_age": 0
    },
    "fingerprint": {
      "enabled": true,
      "signals": [
        "user_agent",
        "accept_language",
        "ip_subnet"
      ]
    }
  },
  "usage": {
    "six_hour_token_limit": 1000000,
    "weekly_token_limit": 5000000,
    "max_context_tokens_per_chat": 150000,
    "auto_summarize_ratio": 0.6
  },
  "backup": {
    "enabled": true,
    "keep": 14,
    "every_hours": 24
  },
  "calendar": {
    "enabled": true,
    "tick_seconds": 30,
    "feed_refresh_minutes": 10,
    "lookahead_hours": 48,
    "late_grace_minutes": 5,
    "max_feeds_per_account": 10,
    "max_alarm_rules": 10,
    "max_ics_bytes": 5242880,
    "fetch_timeout_s": 15,
    "allow_private_urls": false,
    "push_contact": "mailto:admin@example.com"
  }
}
