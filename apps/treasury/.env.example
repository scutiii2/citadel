# Copy to .env (created from this file on first run). Never commit real values.

# Blank: shared token made on first start (INTERNAL_TOKEN_FILE). A value overrides it for this app.
# When set, every route except /health needs it (X-Internal-Token).
INTERNAL_API_TOKEN=

# Connection secrets (Postgres DSNs, Firestore key paths) also go here.
# Use them in configs/config_connections.json as "${NAME}".
