# Docker stack. Copy to .env.
# Service identity keys are made on first start; nothing to set for them.

# Pages allowed to show the five admin apps inside a frame (space-separated origins, e.g. ServiceHub).
# Default 'none': no page may frame them. Needs `docker compose up -d` to take effect.
# HUB_FRAME_ANCESTORS="http://scutiserver1.local:29880 http://192.168.1.50:29880"

# Runtime data and cache, one folder per service inside (.data/armory, .cache/armory, ...).
# Relative paths are relative to this folder. Defaults shown; remove the # to move them.
# CITADEL_DATA_DIR=.data
# CITADEL_CACHE_DIR=.cache

# Overrides for the services. A value here wins over the same name in apps/<service>/.env.
#   TAVILY_API_KEY=...           every service that lists TAVILY_API_KEY in its .env.example
#   ARMORY__TAVILY_API_KEY=...   Armory only (ARMORY, LEGION, PORTCULLIS, STRONGHOLD, TREASURY; two underscores)
# Empty values are ignored. Nothing else in this file reaches a service.

# Admin passwords of the two stack gateways (required: compose refuses to start without them).
# They unlock each gateway's admin page, where Legion's token and the gateway entries are created.
# Provider keys do NOT go in this file; they go in .env.gateways (see .env.gateways.example).
CONVERSATION_GATEWAY_ADMIN_PASSWORD=
DECISION_GATEWAY_ADMIN_PASSWORD=
