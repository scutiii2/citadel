# Provider keys for the model gateways inside Legion. Copy to .env.gateways (git-ignored).
# Only Legion loads this file; no other Citadel service sees it.
# A gateway entry refers to a key by name in its secret field, for example  env:ANTHROPIC_API_KEY
# (save the entry on Legion admin > Connections > Model gateways, see docs/deployment.md). Leave a name empty to use none.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
FREELLMAPI_API_KEY=
