# Internal API auth. Leave blank: every Citadel app then shares one token made on first run (INTERNAL_TOKEN_FILE, default ~/.citadel/internal_token). A value here overrides it for this app only.
# When set, this agent's /mcp rejects requests without X-Internal-Token, and
# the agent sends it on its calls to mcp_server and peer agents. Leave blank
# only while every caller stays on this machine.
INTERNAL_API_TOKEN=

# Credentials for ai_agent. Copy to .env and fill in real values (the loaders
# also create .env from this file on first run). .env is gitignored. Every
# agent the supervisor starts reads this same file.

# Provider and gateway are set per agent in agents/<id>.json (llm.provider,
# llm.gateway). Model provider keys are not kept here: every anthropic and
# openai gateway is saved in ConversationGateway under the same id as its file
# in gateways/<provider>/. Set that service's address and Legion's token on
# the Legion admin app's Connections page.

# openai.azure: deployment names used as model ids (gateways/openai/azure.json)
AZURE_OPENAI_DEPLOYMENT_DEFAULT=
AZURE_OPENAI_DEPLOYMENT_LIGHT=
AZURE_OPENAI_DEPLOYMENT_STANDARD=
AZURE_OPENAI_DEPLOYMENT_HEAVY=

# Decision models (Laya, Jev): their addresses and keys are saved in DecisionGateway, under the
# gateway ids `laya` and `jev`. Set that service's address and Legion's token on the Legion admin
# app's Connections page. TYPESAFE_API_KEY, LAYA_SERVICE_URL and LAYA_TOKEN are no longer read.

# Optional: Hugging Face token. The Triage Assistant downloads its Laya checkpoints (the English one, and
# typed-decisions) from the Hub; downloads work without a token, a token
# only lifts the rate limit.
HF_TOKEN=


# ConversationGateway: Anthropic-protocol agents call their models through it, and the provider
# keys are saved there, not here. Its address and Legion's access token are not set in this file:
# an admin sets them on the Legion admin app's Connections page, and Legion keeps them in Treasury.
# Treasury's address, outside Docker (the compose file sets it for the container):
DB_GATEWAY_URL=
