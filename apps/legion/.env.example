# Copy to .env. Never commit real values. Everything here is optional; empty means the default.
# Service keys are made on first start.
#
# Nothing is needed here. Set in Legion admin instead:
# - Connections: the address and token of each gateway, and the model names that gateway
#   presets leave open (Azure deployments, vLLM models).
# - MCP servers: the tool servers the agents use.
#

# Treasury bootstrap (overrides configs/config_app.json); peer addresses come from its catalog.
TREASURY_URL=
# Optional reachable base address this service registers (http(s)://host:port).
CITADEL_ADVERTISE_URL=
