# Copy to .env. Never commit real values.

# First admin, created on first start.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=


# Tool service tokens (Bard, Scribe) are set in Portcullis admin > Workspace settings > Tool services.

# Email is sent by armory (configs/config_email.json), not from here.
