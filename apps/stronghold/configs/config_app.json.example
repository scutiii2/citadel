{
  "usage": {
    "six_hour_token_limit": 1000000,
    "weekly_token_limit": 5000000
  },
  "pricing": {
    "currency": "USD",
    "models": {
      "claude-haiku-5-5": { "input": 0.0, "output": 0.0 },
      "claude-sonnet-5-5": { "input": 0.0, "output": 0.0 },
      "claude-opus-5-5": { "input": 0.0, "output": 0.0 }
    }
  },
  "calendar": {
    "enabled": true,
    "tick_seconds": 30,
    "feed_refresh_minutes": 10,
    "lookahead_hours": 48,
    "late_grace_minutes": 5,
    "max_feeds_per_account": 10,
    "max_alarm_rules": 10,
    "max_ics_bytes": 5242880,
    "fetch_timeout_s": 15,
    "allow_private_urls": false,
    "push_contact": "mailto:admin@example.com"
  }
}
