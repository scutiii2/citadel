# Copy to .env. Never commit real values. Empty means the default.
# Service keys are made on first start. Data and cache go in the Citadel folder (.data/armory, .cache/armory).

# ---- Set in Armory Admin, not here ----
# The mail account is set on the Email page. These are saved in Armory's database (Settings page) and need no file edit: the Tavily and Firecrawl keys, public addresses and signing keys of PDF and
# video links, LAYA_URL, DB_GATEWAY_INSTANCE/DB_GATEWAY_CONNECTION and MCP_WORKSPACE_DIR.
# A name set here (or in the Citadel root .env) is only the starting value; what an administrator saves there wins.

# Treasury bootstrap (overrides configs/config_app.json); peer addresses come from its catalog.
TREASURY_URL=
# Optional reachable base address this service registers (http(s)://host:port).
CITADEL_ADVERTISE_URL=
