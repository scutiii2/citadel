# Copy to .env. Never commit real values. Referenced from configs/*.json as "${NAME}".

# ---- Server ----
# No login on /mcp. Keep loopback; use 0.0.0.0 only behind a proxy, VPN or firewall.
MCP_HOST=127.0.0.1
MCP_PORT=8010

# ---- Internal auth ----
# Blank: shared token made on first start (INTERNAL_TOKEN_FILE). A value overrides it for this app.
# Required on every /mcp request and POST /upload. Treat it like a password.
INTERNAL_API_TOKEN=

# Tool service tokens: Tokens card on each service's admin page (used by config_extensions.json).
BARD_TOKEN=
SCRIBE_TOKEN=
READER_TOKEN=
LENS_TOKEN=
MIMIC_TOKEN=

# ---- Email ----
# App-specific password on Gmail, Outlook, Yahoo, iCloud. Used as "password" in config_email.json.
# Relay without auth: remove "password" from config_email.json and delete this line. Blank fails at load.
SMTP_PASSWORD=

# ---- SSH ----
# reject: refuse unknown host keys. auto: trust and record the first key seen.
SSH_HOST_KEY_POLICY=reject
SSH_KNOWN_HOSTS=

# ---- Web research / scraping ----
# https://app.tavily.com
TAVILY_API_KEY=
# https://www.firecrawl.dev/app. FIRECRAWL_API_URL blank: hosted API. Self-hosted: key optional.
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=

# ---- Tickets ----
# MCP address of Legion's triage agent (http://legion:9111/mcp in Docker). Blank: tickets not tagged.
LAYA_URL=

# ---- Notes ----
# Notes live in Stronghold's database. Stronghold address, and Treasury connection "stronghold".
# STRONGHOLD_URL=http://127.0.0.1:29650
# DB_GATEWAY_URL=http://127.0.0.1:8071
# DB_GATEWAY_INSTANCE=mcp_server
# DB_GATEWAY_CONNECTION=stronghold

# ---- Optional folders (defaults relative to apps/armory/) ----
# MCP_USAGE_DIR=../legion/data/usage
# MCP_VAULT_DIR=../../../../Brain
# MCP_WORKSPACE_DIR=../../../..
# MCP_WATCHERS_DIR=.data/watchers
