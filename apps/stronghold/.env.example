# Copy to .env. Never commit real values.

# Service identity keys are generated automatically. Optional directory overrides:
# CITADEL_TRUST_DIR=~/.citadel/trust
# CITADEL_IDENTITY_DIR=../../.data/stronghold/identity

# Tool service tokens (Bard, Scribe, Reader) are set in Stronghold admin > Tool services.

# Treasury bootstrap (overrides configs/config_app.json); peer addresses come from its catalog.
TREASURY_URL=
# Optional reachable base address this service registers (http(s)://host:port).
CITADEL_ADVERTISE_URL=
