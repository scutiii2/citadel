__pycache__/
*.pyc
.venv/
.venv_*/
*.egg-info/
.claude/*
!.claude/skills
.pytest_cache/
# Runtime data and cache of every service (see CITADEL_DATA_DIR / CITADEL_CACHE_DIR in .env.example).
/.data/
/.cache/
.secret
.vscode
.vs

# Configs (configs/*.json) are tracked and name secrets as ${VAR}; the values live in .env (never tracked,
# each has a .env.example beside it). .secrets/ is the legacy folder run.py migrates into .env on first start.
/apps/armory/.env
/apps/armory/.secrets/*
!/apps/armory/.secrets/*.example

# ai_agent's real API keys / pinned-provider selection, same treatment
# as mcp_server's secret_*.env above - only .env.example is committed.
/apps/legion/.env
# Agent definitions and gateway presets are tracked; runtime state is not.
/apps/legion/.data/
# Temporary agent writes and gateway migration state remain local.
/apps/legion/agents/*.tmp
/apps/legion/gateways/.initialized
/apps/legion/gateways/*/*.tmp
/apps/legion/gateways/*.tmp


# Runtime state, not source: one-time-code
# records, and any capability's own data/ (e.g. capabilities/otp/data/).
# All hold security-relevant material or are regenerated on every run.
/apps/armory/.data/
/apps/armory/.logs/
/apps/armory/.cache/

*.db



# Runtime logs: combined server.log plus one file per error reference id
# (see chat_app/mcp_server's logging_setup.py / errors.py). Regenerated
# on every run, not source. Anchored to each app's own root (not a bare
# "logs/") - unanchored, this also matched chat_app's SOURCE blueprint at
# pages/logs/, silently excluding it from version control entirely.
/apps/chat_app/logs/

zip_versions/

# Local git worktrees used for isolated feature work (superpowers
# subagent-driven-development) - scratch checkouts, not source.
.worktrees/

# Subagent-driven-development scratch, not source.
.superpowers/

MCPServer.yaml
.sessions/
.output/
PyRFC
dev_rfc.log



# Archive snapshots are never tracked
*.zip

# Dependencies, never tracked.
node_modules/

# db_gateway: real credentials and the SQLite files it creates stay local.
/apps/treasury/.env
/apps/treasury/data/
/apps/treasury/firestore-debug.log
/apps/stronghold/.env
/apps/stronghold/.data/

# docker compose secrets
/.env


# Ember API run cache (regenerated, not source).
/apps/portcullis/.cache/

# Every folder starting with "." or "_" is local state or tooling, never source.
# Re-included: folders that hold tracked files (skills, Codex links, test fixtures).
.*/
_*/
!.agents/
!.claude/
!.codex/
!_fixtures/
