# Copy to .env. Never commit real values. Empty means the default.
# Referenced from configs/*.json as "${NAME}".
# Service keys are made on first start. Data and cache go in the Citadel folder (.data/armory, .cache/armory).

# ---- Server ----
MCP_HOST=127.0.0.1
MCP_PORT=29600

# ---- Email ----
# Sender address, used as "from" in config_email.json.
SMTP_FROM=
# App-specific password on Gmail, Outlook, Yahoo, iCloud. Used as "password" in config_email.json.
# Relay without auth: remove "password" from config_email.json and delete this line. Blank fails at load.
SMTP_PASSWORD=

# ---- SSH ----
# reject: refuse unknown host keys. auto: trust and record the first key seen.
SSH_HOST_KEY_POLICY=reject
# Default: ~/.ssh/known_hosts
SSH_KNOWN_HOSTS=

# ---- Web research and scraping ----
# https://app.tavily.com
TAVILY_API_KEY=
# https://www.firecrawl.dev/app. FIRECRAWL_API_URL blank: hosted API. Self-hosted: key optional.
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=

# ---- PDF and video links ----
# Public address in download links, default http://127.0.0.1:<MCP_PORT>.
MCP_PDF_MERGER_PUBLIC_BASE_URL=
MCP_MEDIA_PUBLIC_BASE_URL=
# Signs the links. Blank: links stop working after a restart.
PDF_MERGER_SIGNING_KEY=
MCP_MEDIA_SIGNING_KEY=

# ---- Tickets ----
# MCP address of Legion's triage agent. Blank: tickets are not tagged.
LAYA_URL=

# ---- Addresses outside Docker (Compose sets them in the stack) ----
# Stronghold, default http://127.0.0.1:29650. It keeps the notes and the brain connections.
STRONGHOLD_URL=
# Treasury, default http://127.0.0.1:29602. The notes use its connection "stronghold".
DB_GATEWAY_URL=
DB_GATEWAY_INSTANCE=
DB_GATEWAY_CONNECTION=

# ---- Obsidian ----
# Semantic search over a read-only vault mount. Blank: not available.
OBSIDIAN_VAULT_PATH=
# Embeddings from Ollama. Defaults: http://127.0.0.1:11434, nomic-embed-text, refresh 60 seconds.
OBSIDIAN_OLLAMA_URL=
OBSIDIAN_EMBED_MODEL=
OBSIDIAN_REFRESH_SECONDS=
# Local REST API of one vault, for an account with no brain connection in Stronghold.
# Defaults: https://127.0.0.1:27124, timeout 5 seconds, TLS checked, writes off.
OBSIDIAN_BASE_URL=
OBSIDIAN_API_KEY=
OBSIDIAN_TIMEOUT=
OBSIDIAN_VERIFY_TLS=
OBSIDIAN_ALLOW_WRITE=

# ---- Folders the read-only tools look at (defaults relative to apps/armory/) ----
# Default ../../../../Brain and ../../../..
MCP_VAULT_DIR=
MCP_WORKSPACE_DIR=
